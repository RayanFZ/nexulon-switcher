<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="E1EC8C56-C250-401D-A032-A147BC5025E8"
           Name="Nexulon Switcher"
           Language="1033"
           Version="1.0.0"
           Manufacturer="Nexulon Switcher"
           UpgradeCode="ED29BF99-E556-41FD-8B9D-0B511ACA1B38">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             InstallPrivileges="elevated"
             Description="Nexulon Switcher — fast account switching for game launchers"
             Comments="Installs Nexulon Switcher and the WebView2 runtime it needs for all users of this PC." />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Nexulon Switcher is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="..\assets\nexulon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPCONTACT" Value="Nexulon Switcher" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />

    <!--
      WebView2 is the only runtime this app needs. The Evergreen bootstrapper is
      shipped inside the MSI and runs silently, elevated, when the machine-wide
      runtime is absent. That way a fresh Windows install never has to download
      anything before the app can start.
    -->
    <Property Id="WV2_MACHINE">
      <RegistrySearch Id="WV2MachineSearch"
                      Root="HKLM"
                      Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
                      Name="pv"
                      Type="raw" />
    </Property>
    <Property Id="WV2_USER">
      <RegistrySearch Id="WV2UserSearch"
                      Root="HKCU"
                      Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
                      Name="pv"
                      Type="raw" />
    </Property>

    <CustomAction Id="SetARPINSTALLLOCATION"
                  Property="ARPINSTALLLOCATION"
                  Value="[INSTALLFOLDER]" />
    <CustomAction Id="InstallWebView2"
                  FileKey="WebView2BootstrapperFile"
                  ExeCommand="/silent /install"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <InstallExecuteSequence>
      <Custom Action="SetARPINSTALLLOCATION" After="CostFinalize">NOT Installed</Custom>
      <Custom Action="InstallWebView2" After="InstallFiles">NOT WV2_MACHINE</Custom>
    </InstallExecuteSequence>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Nexulon Switcher">

          <Component Id="AppExe" Guid="DC17294E-79D5-42E0-BCB2-3D44F77B20C6" Win64="yes">
            <File Id="AppExeFile"
                  Source="payload\Nexulon Switcher.exe" />
            <RegistryValue Root="HKLM"
                           Key="Software\NexulonSwitcher"
                           Name="InstallDir"
                           Type="string"
                           Value="[INSTALLFOLDER]"
                           KeyPath="yes" />
            <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
          </Component>

          <Component Id="LicenseFile" Guid="B18A4699-AE37-486C-8ED9-58EEC8B07E77" Win64="yes">
            <File Id="LicenseTxt" Source="..\LICENSE" Name="LICENSE.txt" />
            <RegistryValue Root="HKLM"
                           Key="Software\NexulonSwitcher"
                           Name="LicenseFile"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
          </Component>

          <Component Id="StartMenuShortcut" Guid="5BF6C189-1F0C-451B-A6C5-9311B8AF693D" Win64="yes">
            <Shortcut Id="StartMenuLink"
                      Directory="ProgramMenuDir"
                      Name="Nexulon Switcher"
                      Description="Switch game launcher accounts"
                      Target="[INSTALLFOLDER]Nexulon Switcher.exe"
                      WorkingDirectory="INSTALLFOLDER"
                      Icon="AppIcon" />
            <RemoveFolder Id="RemoveProgramMenuDir" Directory="ProgramMenuDir" On="uninstall" />
            <RegistryValue Root="HKLM"
                           Key="Software\NexulonSwitcher"
                           Name="StartMenuShortcut"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
          </Component>

          <Component Id="DesktopShortcut" Guid="1F931DBF-BF44-438B-9FBE-CC23899E2CA2" Win64="yes">
            <Shortcut Id="DesktopLink"
                      Directory="DesktopFolder"
                      Name="Nexulon Switcher"
                      Description="Switch game launcher accounts"
                      Target="[INSTALLFOLDER]Nexulon Switcher.exe"
                      WorkingDirectory="INSTALLFOLDER"
                      Icon="AppIcon" />
            <RegistryValue Root="HKLM"
                           Key="Software\NexulonSwitcher"
                           Name="DesktopShortcut"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
          </Component>

          <Directory Id="RedistFolder" Name="redist">
            <Component Id="WebView2Bootstrapper" Guid="C4E1A7D2-8F3B-4B6A-9E52-6A0D7B1C3F84" Win64="yes">
              <File Id="WebView2BootstrapperFile"
                    Source="redist\MicrosoftEdgeWebView2Setup.exe"
                    Name="MicrosoftEdgeWebView2Setup.exe" />
              <RegistryValue Root="HKLM"
                             Key="Software\NexulonSwitcher"
                             Name="WebView2Bootstrapper"
                             Type="integer"
                             Value="1"
                             KeyPath="yes" />
              <RemoveFolder Id="RemoveRedistFolder" Directory="RedistFolder" On="uninstall" />
            </Component>
          </Directory>

        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="Nexulon Switcher" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <Feature Id="MainFeature" Title="Nexulon Switcher" Level="1">
      <ComponentRef Id="AppExe" />
      <ComponentRef Id="LicenseFile" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="WebView2Bootstrapper" />
    </Feature>

    <UIRef Id="WixUI_Minimal" />
  </Product>
</Wix>
