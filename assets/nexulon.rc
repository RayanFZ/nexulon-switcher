#include <windows.h>

1 ICON "nexulon.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Nexulon Corp"
            VALUE "FileDescription",  "Nexulon Switcher"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "nexulon-switcher"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Nexulon Corp. All rights reserved."
            VALUE "OriginalFilename", "Nexulon Switcher.exe"
            VALUE "ProductName",      "Nexulon Switcher"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
